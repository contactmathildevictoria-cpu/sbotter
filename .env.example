# Supabase — get these from your Supabase project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Apify
# APIFY_TOKEN is only required when production webhooks land here and we have
# to fetch the dataset back from Apify. For local testing with inline `items`,
# only APIFY_WEBHOOK_SECRET matters.
APIFY_TOKEN=
# Shared HMAC secret used by the Actor (env: SPOTTER_WEBHOOK_SECRET) and the
# server. Any random ~32-char string works. e.g. `openssl rand -hex 32`.
APIFY_WEBHOOK_SECRET=
# Static bearer token for Apify's NATIVE webhooks (which can't compute the HMAC).
# Set the same value here, in the Apify webhook's `Authorization: Bearer <token>`
# header, and in Vercel env vars. Generate with `openssl rand -hex 32`.
APIFY_WEBHOOK_TOKEN=

# Stripe (placeholders — not wired yet)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# CVR enrichment (cvrapi.dk)
# Optional. Without it you get 50 free lookups/day/IP. Set a token to remove the
# limit (sent as HTTP Basic auth username). Get one at https://cvrapi.dk.
CVRAPI_TOKEN=
# Secret for the /api/cron/enrich endpoint. Vercel Cron sends it as
# `Authorization: Bearer <CRON_SECRET>`. Required for the cron job to run.
# Generate with `openssl rand -hex 32`.
CRON_SECRET=

# Claude (placeholder — enrichment comes later)
ANTHROPIC_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# cvrlookup.dk API key ("cvr_...") for CVR enrichment. Replaces CVRAPI_TOKEN.
CVRLOOKUP_API_KEY=